AGY_API_KEY=your-secret-key-here
ADMIN_PASSWORD=your-admin-password-here
ANTHROPIC_COMPAT_API_KEY=

# --- Account Pool (optional, disabled by default) ---
AGY_POOL_ENABLED=false
AGY_POOL_DIR=~/.agy2api-pool
AGY_POOL_COOLDOWN_SECONDS=3600
AGY_POOL_MAX_RETRIES=3
AGY_POOL_GIT_AUTOSYNC=false
AGY_POOL_GIT_AUTOSYNC_INTERVAL_SECONDS=3600

# --- Stats ---
AGY_STATS_DB_PATH=app/data/stats.db
AGY_STATS_DOWN_THRESHOLD=3

# --- Transport (optional, cli by default) ---
# cli:  spawn a fresh `agy` subprocess per request (default).
# warm: session-sticky pool of live `agy` processes with token-level streaming.
#       Continuing an existing conversation reuses an authenticated process.
# http: direct HTTP to Cloud Code Assist (no agy agent tools/system prompt).
#       Requires ANTIGRAVITY_CLIENT_ID and ANTIGRAVITY_CLIENT_SECRET for OAuth refresh.
#       User-Agent should match the agy CLI for some model families.
AGY_TRANSPORT=cli
AGY_HTTP_CLOUDCODE_BASE=https://daily-cloudcode-pa.googleapis.com
AGY_HTTP_QUOTA_PROJECT=aicode-consumers
# Optional override if the default UA is wrong for your agy build:
# AGY_HTTP_USER_AGENT=
AGY_WARM_IDLE_TIMEOUT_SECONDS=600
AGY_WARM_MAX_SESSIONS=20

# --- OAuth refresh (required for http transport; also used before agy CLI calls) ---
# Credentials are read from ~/.gemini/oauth_creds.json (gemini-cli / agy shared file)
# or ~/.gemini/antigravity-cli/antigravity-oauth-token (nested antigravity format).
# Never commit real client secrets or access tokens.
AGY_OAUTH_REFRESH_ENABLED=true
AGY_OAUTH_REFRESH_SKEW_SECONDS=120
# Quota verify cache TTL (seconds); default 300.
# AGY_OAUTH_VERIFY_CACHE_SECONDS=300
ANTIGRAVITY_CLIENT_ID=
ANTIGRAVITY_CLIENT_SECRET=
# Optional live Bearer override when disk token is stale (do not commit real tokens):
# AGY_ACCESS_TOKEN=
# AGY_BEARER_TOKEN=
# Or patch disk: python scripts/patch_access_token.py <access_token>

# Proxy for all Google API traffic (OAuth, Cloud Code Assist, quota verify, agy CLI subprocess).
# Full URL or user:pass@host:port (http:// is assumed when scheme is omitted).
# AGY_GOOGLE_PROXY=http://user:pass@host:port
# Localhost MITM proxies (Charles, mitmproxy) auto-disable TLS verify; override with AGY_SSL_VERIFY=true.
# AGY_SSL_VERIFY=false
# AGY_FORCE_MODEL=max-gem
# Force all requests (including Claude Code auto-mode classifier) to one backend model.
# Alias names (e.g. max-gem) are resolved via MODEL_ALIASES.
# Response JSON/SSE still echoes the client's requested model name.

# Short-circuit Claude Code auto-mode classifier prompts without calling the LLM.
# AGY_AUTO_CLASSIFIER_SHORTCUT=true
# AGY_AUTO_CLASSIFIER_RESPONSE=<block>no</block>

# --- HTTP transport tuning (empty-response / tool-context fixes) ---
# AGY_HTTP_DEBUG=false
# AGY_THOUGHT_AS_TEXT=true
# AGY_HTTP_EMPTY_AS_EMPTY_CONTENT=true
# Trim tool result payloads in HTTP transport (recommended for long tool sessions).
# AGY_HTTP_TRIM_TOOL_RESULTS=true
# AGY_HTTP_MAX_TOOL_RESULT_CHARS=12000
# AGY_HTTP_OLD_TOOL_RESULT_CHARS=4000
# AGY_HTTP_RETRY_TOOL_RESULT_CHARS=4000
# AGY_HTTP_MAX_OUTPUT_TOKENS=8192
# GEMINI_CLIENT_ID=
# GEMINI_CLIENT_SECRET=
