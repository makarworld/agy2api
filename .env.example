# ==============================================================================
# AGY2API — Конфигурация окружения (.env)
# ==============================================================================
# Скопируйте этот файл в .env и укажите ваши параметры:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. БЕЗОПАСНОСТЬ И АВТОРИЗАЦИЯ (Security & Access Keys)
# ------------------------------------------------------------------------------
# Пароль для доступа в веб-панель администратора (AGY2API Admin UI).
# Оставьте пустым при первой настройке или задайте свой пароль:
ADMIN_PASSWORD=

# Мастер API-ключ для внешних клиентов (Cursor, Continue, LibreChat, curl).
# Клиенты передают его в заголовке: Authorization: Bearer <AGY_API_KEY>
AGY_API_KEY=

# Опциональный отдельный API-ключ для Anthropic клиентов (Claude Code, Cline).
# Если не задан, используется значение AGY_API_KEY:
ANTHROPIC_COMPAT_API_KEY=


# ------------------------------------------------------------------------------
# 2. GOOGLE OAUTH & ANTIGRAVITY (Авторизация и подписка Gemini)
# ------------------------------------------------------------------------------
# Официальные OAuth Client ID и Secret Google для Gemini Code Assist / Antigravity.
# Используются для автоматического обмена токенов и обновления авторизации:
ANTIGRAVITY_CLIENT_ID=1071006060591-tmhssin2h21lcre235vtolojh4g403ep.apps.googleusercontent.com
ANTIGRAVITY_CLIENT_SECRET=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

# Включить автоматическое обновление access-токенов через Google OAuth (true/false):
AGY_OAUTH_REFRESH_ENABLED=true

# За сколько секунд до истечения токена инициировать рефреш (по умолчанию 120):
AGY_OAUTH_REFRESH_SKEW_SECONDS=120

# Кэш верификации квот (в секундах, по умолчанию 300):
# AGY_OAUTH_VERIFY_CACHE_SECONDS=300


# ------------------------------------------------------------------------------
# 3. ПУЛ АККАУНТОВ И РОТАЦИЯ (Account Pool & Rotation)
# ------------------------------------------------------------------------------
# Включить пул нескольких Google-аккаунтов для распределения нагрузки (true/false):
AGY_POOL_ENABLED=true

# Папка хранения данных и снимков авторизации пула:
AGY_POOL_DIR=~/.agy2api-pool

# Время кулдауна аккаунта при получении 429 / исчерпании лимитов (в секундах):
AGY_POOL_COOLDOWN_SECONDS=3600

# Максимальное количество попыток ротации на следующий аккаунт при ошибке:
AGY_POOL_MAX_RETRIES=3

# Автоматическая синхронизация аккаунтов пула через git (pull/push):
AGY_POOL_GIT_AUTOSYNC=false
AGY_POOL_GIT_AUTOSYNC_INTERVAL_SECONDS=3600


# ------------------------------------------------------------------------------
# 4. ТРАНСПОРТ И МАРШРУТИЗАЦИЯ МОДЕЛЕЙ (Transport, Models & Routing)
# ------------------------------------------------------------------------------
# Режим транспорта:
#   http - прямой высокоскоростной HTTP к Cloud Code Assist API (рекомендуется)
#   cli  - вызов бинарника agy subprocess на каждый запрос (legacy)
#   warm - постоянный пул процессов agy с поддержкой сессий
AGY_TRANSPORT=http

# Базовый URL Cloud Code Assist API:
AGY_HTTP_CLOUDCODE_BASE=https://daily-cloudcode-pa.googleapis.com
AGY_HTTP_QUOTA_PROJECT=aicode-consumers

# Принудительная фиксация модели для всех запросов (например, max-gem):
# Закомментируйте, чтобы модель выбирал клиент (Cursor / Claude Code):
AGY_FORCE_MODEL=max-gem

# Алиасы моделей: сопоставление коротких имен и реальных бэкенд моделей:
AGY_MODEL_ALIASES=max-gem=gemini-3.8-flash-high, gem-low=gemini-3.8-flash-low

# Классификатор запросов Claude Code (auto-mode classifier):
#   skip - всегда пропускать и сразу отвечать в LLM (быстрее и экономит квоту)
AGY_AUTO_CLASSIFIER_MODEL=skip
AGY_AUTO_CLASSIFIER_EFFORT=low
AGY_AUTO_CLASSIFIER_SHORTCUT=true


# ------------------------------------------------------------------------------
# 5. ВЫВОД РАССУЖДЕНИЙ И ФОРМАТИРОВАНИЕ (Thinking & Stream Output)
# ------------------------------------------------------------------------------
# Выводить мысли модели (thinking/reasoning) в виде текстового блока <think>:
AGY_THOUGHT_AS_TEXT=true

# Шаблон обрамления мыслей:
AGY_THOUGHT_TEXT_PREFIX="<think>\n"
AGY_THOUGHT_TEXT_SUFFIX="\n</think>\n\n"

# Возвращать пустой ответ как валидный контент при остановке:
AGY_HTTP_EMPTY_AS_EMPTY_CONTENT=true

# Лимиты токенов вывода:
AGY_HTTP_MAX_OUTPUT_TOKENS=65536

# Обрезка слишком длинных результатов инструментов (true/false):
AGY_HTTP_TRIM_TOOL_RESULTS=false
# AGY_HTTP_MAX_TOOL_RESULT_CHARS=12000


# ------------------------------------------------------------------------------
# 6. ПРОКСИ И СЕТЬ (Proxy & SSL)
# ------------------------------------------------------------------------------
# Прокси для всех запросов к Google API (OAuth, стриминг, проверка квот):
# Формат: http://user:pass@host:port или socks5://host:port
# AGY_GOOGLE_PROXY=http://127.0.0.1:10808

# Проверка SSL сертификатов (false для Charles/mitmproxy/Fiddler/zapret):
AGY_SSL_VERIFY=true


# ------------------------------------------------------------------------------
# 7. СТАТИСТИКА И ЛОГИРОВАНИЕ (Stats, Logs & Retention)
# ------------------------------------------------------------------------------
# Путь к SQLite базе статистики и истории запросов:
AGY_STATS_DB_PATH=app/data/stats.db

# Порог последовательных ошибок для пометки аккаунта как unhealthy:
AGY_STATS_DOWN_THRESHOLD=3

# Срок хранения истории запросов и чатов (в днях, по умолчанию 30):
AGY_CHAT_TURNS_RETENTION=30

# Подробный HTTP дебаг-лог запросов и ответов в консоли (true/false):
AGY_HTTP_DEBUG=false
