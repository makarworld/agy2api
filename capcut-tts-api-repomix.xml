            {
                "text": "Hôm nay chúng ta sẽ tìm hiểu về CapCut API",
                "start_time": 1600,
                "end_time": 4500,
                "words": []
            }
        ]
    }

    mock_query_response = {
        "status_code": 0,
        "data": {
            "tasks": [
                {
                    "status": "success",
                    "payload": mock_stt_payload
