from capcut_tts_api import CapCutClient

client = CapCutClient()

# Lấy danh sách các giọng đọc Tiếng Việt
voices = client.list_voices(lang="vi-VN")

for v in voices:
    print(f"{v.display_name} ({v.voice_type}) -> Resource ID: {v.resource_id}")
